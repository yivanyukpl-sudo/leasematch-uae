# Copy this file to .env.local and fill in real values to enable them.
# .env.local is git-ignored — never commit real secrets.

# Stripe Checkout (real card payments, redirects to a Stripe-hosted page).
# Get a free test key from https://dashboard.stripe.com/test/apikeys
# (no business verification needed to start in test mode).
# Test card for a full run-through: 4242 4242 4242 4242, any future date, any CVC.
STRIPE_SECRET_KEY=

# Used to build absolute Stripe redirect URLs when running behind a proxy
# that Next.js can't infer the public host from. Usually not needed locally.
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Claude (Anthropic) — used for every AI feature when set: the agent chat,
# Bayut/Dubizzle search, AI photo inspection and the deal assistant. Get a key
# at https://console.anthropic.com (API credits are separate from a claude.ai
# subscription). Server-side only. Optional: CLAUDE_MODEL (default claude-opus-5-5).
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# OpenAI — fallback when ANTHROPIC_API_KEY isn't set. The AI agent (tenant chat assistant, market search across Bayut/Dubizzle
# via OpenAI's hosted web search, and the "this looks pricey" negotiation
# nudge). Get a key from https://platform.openai.com/api-keys
# Server-side only: never prefix it with NEXT_PUBLIC_.
OPENAI_API_KEY=
# Optional: override the model (default gpt-5.5).
# OPENAI_MODEL=

# Crypto payments (real redirect to a NOWPayments-hosted checkout page).
# Get a key from https://nowpayments.io/ (or a sandbox key from
# https://sandbox-account.nowpayments.io/ for testing without real funds —
# if using a sandbox key, also set NOWPAYMENTS_SANDBOX=true below).
NOWPAYMENTS_API_KEY=
# NOWPAYMENTS_SANDBOX=true

# Email for the agent's external-listing outreach (drafting and sending real
# inquiry emails to listings found on Bayut/Property Finder/Dubizzle, and
# routing real replies back into the app). Uses Mailgun for both sending and
# receiving. Get a free account (with a sandbox domain you can test against
# immediately, no domain purchase needed) at https://www.mailgun.com/.
# MAILGUN_API_KEY is your account's private API key from the Mailgun
# dashboard. MAILGUN_DOMAIN is the sending domain (the sandbox domain works
# for testing, e.g. sandboxXXXX.mailgun.org).
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
# Only needed if inbound mail is routed through a different domain than you
# send from — otherwise it defaults to MAILGUN_DOMAIN.
# MAILGUN_INBOUND_DOMAIN=
#
# To receive replies, add a Mailgun Route (Sending > Routes in the
# dashboard) that matches recipient "inquiry-.*@yourdomain" and forwards to
# this app's /api/inbound/email endpoint — Mailgun needs a public URL to
# reach it, so this only works once the app is deployed somewhere reachable
# from the internet (not on localhost).
